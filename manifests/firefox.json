{
  "manifest_version": 3,
  "name": "Tab Control",
  "version": "0.1.0",
  "description": "Inspect and control browser tabs through an authorized local agent.",
  "icons": {
    "16": "icons/tab-control-16.png",
    "32": "icons/tab-control-32.png",
    "48": "icons/tab-control-48.png",
    "128": "icons/tab-control-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-control@example.invalid",
      "strict_min_version": "119.0"
    }
  },
  "permissions": ["storage", "tabs", "contextualIdentities", "cookies", "tabGroups", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Open Tab Control settings",
    "default_icon": {
      "16": "icons/tab-control-16.png",
      "32": "icons/tab-control-32.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
