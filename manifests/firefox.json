{
  "manifest_version": 3,
  "name": "Tab Control",
  "version": "0.1.0",
  "description": "Inspect and control browser tabs through an authorized local agent.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-control@example.invalid",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["tabs", "contextualIdentities", "cookies", "tabGroups"],
  "background": {
    "scripts": ["inventory.js", "background.js"]
  },
  "action": {
    "default_title": "Tab Control",
    "default_popup": "dashboard.html"
  }
}
